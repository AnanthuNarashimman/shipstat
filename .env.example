# Public URL used in share links and link previews. On Vercel this is filled in automatically
# from the production domain; set it once you have a custom domain.
NEXT_PUBLIC_SITE_URL=

# Optional "packages analyzed" counter (Upstash Redis). Adding the Upstash integration from the
# Vercel Marketplace sets KV_REST_API_URL / KV_REST_API_TOKEN for you. Leave empty to disable.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
